# LOCAL DEVELOPMENT ONLY.
#
# Copy this file to .env and paste your key from
# https://console.anthropic.com/settings/keys
#
# `npm run dev` calls the Anthropic API straight from the browser using this
# key. Production builds do NOT: they POST to /api/anthropic, and the deployed
# serverless function supplies the key from ANTHROPIC_API_KEY (no VITE_ prefix,
# so it is never inlined into the bundle). Set that one in your host's
# environment-variable settings, not here.
VITE_ANTHROPIC_API_KEY=sk-ant-...

# Optional: set to 1 to exercise the /api/anthropic path from a dev server.
# VITE_FORCE_PROXY=1
